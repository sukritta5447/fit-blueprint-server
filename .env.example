PORT=3000
# DATABASE_URL is also supported for existing deployments.
CONNECTION_STRING=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Comma-separated additional frontend origins, for example:
# CORS_ORIGINS=https://app.example.com,https://fit-blueprint-site-git-dev-jip.vercel.app
CORS_ORIGINS=
# Optional AI personalization. The calculator works without these values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=15000
